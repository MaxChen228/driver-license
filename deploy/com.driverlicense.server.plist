<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- driver-license 刷題 app（僅 felix 載入；oscar 有 repo 但不註冊）。
     裝法：cp 到 ~/Library/LaunchAgents/ → launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.driverlicense.server.plist
     停用：launchctl bootout gui/$(id -u)/com.driverlicense.server
     改 app/*.py：launchctl kickstart -k gui/$(id -u)/com.driverlicense.server
     改本 plist：必須 bootout 再 bootstrap（kickstart 不重讀 plist）。

     ⚠️ WorkingDirectory 就是 repo 本身，uvicorn 直接 import 工作目錄裡的 app/。
     在 felix 上編輯這個 repo 等於在動生產環境 —— 程序只要重啟一次（崩潰、
     kickstart、開機）就會載入當下磁碟上的程式碼，包含寫到一半的版本，
     而且照樣會跑 db.init() 就地遷移資料庫。長時間改動前先 bootout。

     對外入口有兩條：
     (1) Cloudflare Tunnel → https://drive.wordnexus.lol（公網，帳號制）
     (2) tailscale serve（TLS 終結在 tailscaled，Let's Encrypt 真憑證）：
       tailscale serve --bg --https=443 http://127.0.0.1:8006
       → https://s-macbook-air.tail8c391d.ts.net/    （tailnet only，非 funnel）
     為什麼非 HTTPS 不可：PWA 的 service worker 只在安全來源註冊，
     http://100.118.39.104:8006 這種純 HTTP 的 LAN 位址一律被瀏覽器拒絕，
     離線功能會整個失效（而且不會有錯誤訊息，只是靜靜地不生效）。

     為什麼綁 127.0.0.1 而不是 Tailscale IP：serve 的回代來源是 tailscaled 自己，
     連到本機的 100.x 位址會繞回 tun 介面而逾時（實測 TLS 握手成功、後端永遠不回應）。
     綁 loopback 後也沒有任何通訊埠暴露在可路由介面上，姿態更緊。
     檢修：ssh 進 felix 後 curl http://127.0.0.1:8006/ -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.driverlicense.server</string>
  <!-- 走 wrapper 而不是直接叫 uvicorn：憑證要從 ~/.secrets 讀進環境變數，
       而這個 plist 是進 repo 的，不能放秘密。實際指令見 deploy/run-server.sh。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/chenliangyu/project/MaxChen228/driver-license/deploy/run-server.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/chenliangyu/project/MaxChen228/driver-license</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- 進度 DB 放 repo 外：git pull / reset 不會清掉使用者進度 -->
    <key>DL_DATA_DIR</key>
    <string>/Users/chenliangyu/driver-license-data</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!-- Standard，不是 Background。Background 會被排到效能核心以外、QoS 降級：
       實測同一份程式碼在 felix 上登入 830ms 對 139ms（Argon2 本身 135ms），
       每個請求都慢約 6 倍，Argon2 閘的吞吐也跟著掉到 1/6。這是對外的 web 服務，
       不是可以讓路的背景工作（那種是 com.driverlicense.backup）。 -->
  <key>ProcessType</key>
  <string>Standard</string>
  <key>StandardOutPath</key>
  <string>/Users/chenliangyu/Library/Logs/driver-license.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/chenliangyu/Library/Logs/driver-license.err.log</string>
</dict>
</plist>
